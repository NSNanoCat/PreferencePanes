{
    "id": "example.module",
    "name": "Example Module",
    "author": "Example",
    "icon": "https://biliverse.github.io/settings/assets/Enhanced_light.png",
    "settings": [
        { "id": "@Example.Module.Settings.enabled", "name": "启用功能", "type": "boolean", "val": true },
        {
            "id": "@Example.Module.Settings.mode",
            "name": "运行模式",
            "type": "selects",
            "val": "auto",
            "items": [{ "key": "auto", "label": "自动" }, { "key": "manual", "label": "手动" }]
        },
        {
            "id": "@Example.Module.Settings.items",
            "name": "选项",
            "type": "checkboxes",
            "val": ["first"],
            "items": [{ "key": "first", "label": "第一项" }, { "key": "second", "label": "第二项" }]
        },
        {
            "id": "@Example.Module.Settings.notes",
            "name": "Notes",
            "type": "textarea",
            "val": "",
            "placeholder": "One entry per line",
            "rows": 3,
            "autoGrow": true
        }
    ]
}
