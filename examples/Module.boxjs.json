{
    "id": "example.module",
    "name": "PreferencePanes 控件示例",
    "author": "Example",
    "icon": "https://example.com/module.png",
    "desc": "内置示例覆盖全部受支持的 BoxJS 设置项，并展示历史存储值的非阻断提示。",
    "settings": [
        { "id": "@Example.Module.Settings.enabled", "name": "[基础] 启用功能", "type": "boolean", "val": true },
        {
            "id": "@Example.Module.Settings.mode",
            "name": "[基础] 运行模式",
            "type": "selects",
            "val": "auto",
            "items": [{ "key": "auto", "label": "自动" }, { "key": "manual", "label": "手动" }]
        },
        {
            "id": "@Example.Module.Settings.items",
            "name": "[基础] 多选项目",
            "type": "checkboxes",
            "val": ["first"],
            "items": [{ "key": "first", "label": "第一项" }, { "key": "second", "label": "第二项" }]
        },
        {
            "id": "@Example.Module.Settings.displayName",
            "name": "[文本] 显示名称",
            "type": "text",
            "val": "PreferencePanes",
            "placeholder": "输入显示名称"
        },
        {
            "id": "@Example.Module.Settings.notes",
            "name": "[文本] 备注",
            "type": "textarea",
            "val": "这里可以输入多行内容。",
            "placeholder": "每行一项",
            "rows": 3,
            "autoGrow": true
        },
        {
            "id": "@Example.Module.Settings.retries",
            "name": "[数值] 重试次数",
            "type": "number",
            "val": 3,
            "desc": "格式错误的历史值会回退到默认值，并在这里显示提示。"
        },
        {
            "id": "@Example.Module.Settings.categories",
            "name": "[链接] 打开 Bilibili 分类",
            "type": "url",
            "val": "bilibili://main/top_category",
            "desc": "点击打开 Bilibili 分类页面。"
        }
    ]
}
