#!name=PreferencePanes integration example
#!desc=集成模板，example.org 和 assets.example.org 均须替换为实际地址；不部署任何 /api/ 静态文件。

[Map Local]
# 主入口维护者只配置一次页面外壳和公共资源 Mock。
^https://example\.org/settings/?$ data-type=file data="https://assets.example.org/index.html" status-code=200 header="Content-Type:text/html; charset=utf-8|Cache-Control:no-store"
^https://example\.org/resources/preference-panes\.mjs$ data-type=file data="https://assets.example.org/preference-panes.mjs" header="Content-Type:text/javascript; charset=utf-8"
^https://example\.org/resources/panel\.css$ data-type=file data="https://assets.example.org/panel.css" header="Content-Type:text/css; charset=utf-8"
# 每个模块只添加自己的配置 Mock；HEAD 和 GET 使用同一个资源。
^https://example\.org/api/Module/$ data-type=file data="https://assets.example.org/Module.boxjs.json" status-code=200 header="Content-Type:application/json; charset=utf-8|Cache-Control:no-store"

[Script]
# 每个模块限定自己的路径，引用相同通用脚本；字段与 storageKey 都从 BoxJS 读取。
Module-preferences = type=http-request,pattern=^https://example\.org/api/Module/[^/?]+,requires-body=true,max-size=262144,script-path=https://assets.example.org/preference-panes.request.js,argument=origin=https://example.org&configURL=https://assets.example.org/Module.boxjs.json,timeout=10

[MITM]
hostname = %APPEND% example.org
